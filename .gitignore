# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Environments / tool caches
.venv/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.hypothesis/
.coverage
.coverage.*
coverage.xml
htmlcov/

# Datasets are hash-stamped, not committed (repo-root only, not the src/preceptx/data package)
/data/

# Per-run artefacts: only frozen config/manifest/metrics/figures are committed (added per run).
# Raw logs, trained probes, embedding caches and our own numeric caches never are.
# The per-job serving captures serve.sh writes at the runs/ root. Untracked AND unignored, they
# put the cluster checkout permanently in `git status --porcelain`, and manifest.git_dirty reads
# exactly that - so every manifest written on Myriad would record git_dirty: true and stop being a
# provenance record. The contents are not lost: build_sweep_manifest embeds the values and a digest
# of the bytes into manifest.json, which is the artefact that is committed.
runs/serve_env*.json
runs/serve_env*.tmp
runs/*/handoffs.jsonl
runs/*/probes/
runs/*/embeddings/
# The handoff dataset itself: hash-stamped Parquet parts plus their index. Raw episode data, never
# committed - a frozen result is its manifest, metrics, table and figure, not its rows.
runs/**/*.parquet
runs/**/index.json
# Interim substrates: local-pilot and benchmark-smoke episodes are decision inputs, never headline
# data, so nothing under them is committed (the ladder table itself sits directly in runs/bench).
runs/local/
# fetch.sh's staging area: a mirror of the cluster, never the frozen copy. Frozen artefacts are
# promoted deliberately into runs/rq1/<hash>/ instead.
runs/myriad/
# preceptx-calibrate's working directory: the joblibs are trained probes and are already
# covered by *.joblib, and calibration.json is promoted into runs/rq1/<hash>/ when frozen.
runs/*-calibration/
runs/bench/smoke/
*.npy
*.joblib
.embed_cache/

# Model / HF caches and weights
.cache/
*.bin
*.safetensors

# OS / editor
.DS_Store
.idea/
.vscode/

# Secrets
.env

# Working-input PDFs: absorbed into docs/methodology.md and the deviation register; not tracked.
*.pdf
